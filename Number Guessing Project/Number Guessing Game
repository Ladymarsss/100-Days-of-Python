#START SCREEN & DIFFICULTY OPTION
def game_start():
    print(art.logo)
    print("Welcome to the Number Guessing Game!\nI'm thinking of a number between 1 and 100.")
    # Choose gaming difficulty
    game_mode = input("Choose a difficulty. Type 'easy' or 'hard':\n").lower()
    if game_mode == "easy":
        easy_mode()
    elif game_mode == "hard":
        hard_mode()
