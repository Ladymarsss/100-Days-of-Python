import art
print(art.logo)
print("Welcome to the Secret Auction Program")

auction_bidders = {}

def auction_log():
    winner_name = ""
    highest_bid = 0
    name = input("What is your name?: \n")
    bid = int(input("What is your bid?: \n$ "))
    auction_bidders[name] = bid
    bidders = input("Are there any other bidders? 'yes' or 'no'.").lower()
    if bidders == 'yes':
        print("\n" * 100)
        auction_log()
    elif bidders == 'no':
        for bidder in auction_bidders:
            if auction_bidders[bidder] > highest_bid:
                highest_bid = auction_bidders[bidder]
                winner_name = bidder
            print(f"\nThe winner is {winner_name} with a bid of ${highest_bid}.")

auction_log()
